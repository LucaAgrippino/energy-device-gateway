menu "Wi-Fi Manager Configuration"

    config WIFI_STA_TIMEOUT_S
        int "STA connection timeout (seconds)"
        default 10

    config WIFI_MAX_RETRIES
        int "Max STA reconnect retries before AP fallback"
        default 5

    config WIFI_AP_SSID
        string "AP mode SSID"
        default "EDG-Setup"

    config WIFI_AP_PASSWORD
        string "AP mode password"
        default "edg12345"

    config WIFI_AP_CHANNEL
        int "AP mode channel"
        default 1
        range 1 13

    config WIFI_PROVISION_PORT
        int "Provisioning HTTP server port (AP mode)"
        default 8080
        help
            Separate from the telemetry dashboard's port (publisher's
            WS_SERVER_PORT, default 80) so both servers can run at once:
            WsPublisher's dashboard stays reachable at all times (sensors run
            regardless of Wi-Fi state), while this port serves the
            credential-entry form only while in AP mode.

endmenu
